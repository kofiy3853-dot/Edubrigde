# EduBridge OS - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env itself.

# ============================================
# Application
# ============================================
APP_NAME=edubridge-os
APP_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/edubridge?schema=public

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Kafka
# ============================================
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=edubridge

# ============================================
# MinIO (Object Storage)
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=edubridge

# ============================================
# Authentication
# ============================================
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRY=7d
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:4000/auth/callback

# ============================================
# Monitoring
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# ============================================
# External Services
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@edubridge.com

# ============================================
# Frontend
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
